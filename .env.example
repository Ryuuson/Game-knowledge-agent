# Any OpenAI-compatible chat model.
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL=your_chat_model

# Main retrieval profile: BGE runs locally after setup.
RAG_BACKEND=bge
# Hybrid retrieval: dense BGE and BM25 each contribute this many candidates.
RAG_DENSE_CANDIDATES=20
RAG_LEXICAL_CANDIDATES=20
# Reciprocal-rank fusion constant and maximum combined evidence length sent to the chat model.
RAG_RRF_K=60
# Keep dense semantic ranking dominant; BM25 only supplies exact-term evidence.
RAG_DENSE_RRF_WEIGHT=1.0
RAG_LEXICAL_RRF_WEIGHT=0.25
RAG_EVIDENCE_CHAR_BUDGET=9000

# Optional visual model for OCR. When blank, the main chat model is used.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Optional: the author currently uses Metaso as the built-in web-search adapter.
# Leave blank to disable web search. Other services, such as Tavily, need their own adapter.
METASO_API_KEY=

# Local file writes are disabled by default. Set to true only when note creation is needed.
ENABLE_NOTE_WRITES=false

# Optional Ark retrieval profile. Needed only when RAG_BACKEND=ark.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_EMBEDDING_MODEL=
