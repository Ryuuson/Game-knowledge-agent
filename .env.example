# Any OpenAI-compatible chat model.
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL=your_chat_model

# OpenViking server used for game knowledge and durable memory.
OPENVIKING_BASE_URL=http://127.0.0.1:1933
# Leave blank in local dev-auth mode. Use a tenant-scoped key when auth is enabled.
OPENVIKING_API_KEY=
# Optional peer isolation identity for multi-tenant OpenViking deployments.
OPENVIKING_ACTOR_PEER_ID=
OPENVIKING_TIMEOUT_SECONDS=30
OPENVIKING_IMPORT_TIMEOUT_SECONDS=1800
OPENVIKING_EVIDENCE_CHAR_BUDGET=12000

# Optional visual model for OCR. When blank, the main chat model is used.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Optional: the author currently uses Metaso as the built-in web-search adapter.
# Leave blank to disable web search. Other services, such as Tavily, need their own adapter.
METASO_API_KEY=
