# Optional chat configuration. Leave blank for local retrieval without AI answers.
# Chat and summaries send context to this provider and may incur API charges.
# Any OpenAI-compatible chat model.
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL=your_chat_model

# Main retrieval profile: BGE runs locally after setup.ps1 -WithBge and index build.
RAG_BACKEND=bge

# Optional visual model for OCR. When blank, the main chat model is used.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Optional Metaso web-search adapter.
# Leave blank to disable web search. Other services, such as Tavily, need their own adapter.
METASO_API_KEY=

# Optional Ark retrieval profile. Needed only when RAG_BACKEND=ark.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_EMBEDDING_MODEL=

# Local retrieval strategy; evaluated alternatives: keyword, hybrid.
RETRIEVAL_MODE=bge
# Limits apply to chat requests and current-turn tool loops.
LLM_TIMEOUT=60
MAX_TOOL_ROUNDS=6
CONTEXT_TOKEN_BUDGET=12000
RECENT_USER_TURNS=4
SUMMARY_TOKEN_BUDGET=1500
# Optional: relative paths resolve inside this project.
GAME_AGENT_DB=
