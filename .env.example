# Any OpenAI-compatible chat model. These settings take precedence over ARK_*.
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL=your_chat_model

# Retrieval profile: bge (default, fully local after setup) or ark (requires the matching Ark index).
RAG_BACKEND=bge

# Optional visual model for OCR. When blank, the main chat model is used.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Optional: enables the built-in Metaso web-search tool. Leave blank to disable it.
METASO_API_KEY=

# Legacy Ark compatibility. Needed only when RAG_BACKEND=ark or when using Ark as the chat model.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
ARK_VISION_MODEL=
ARK_EMBEDDING_MODEL=
